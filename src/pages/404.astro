---
import BaseLayout from '../layouts/BaseLayout.astro'
import PlaneMark from '../components/PlaneMark.astro'
---

<BaseLayout title="Not found" description="This page doesn't exist." noindex canonical={false}>
  <section class="not-found">
    <PlaneMark size={72} />
    <h1>Purely imaginary</h1>
    <p>This page doesn't exist, at least not on the real axis.</p>
    <p><a href="/">Back to the contents</a> or browse <a href="/archive">the archive</a>.</p>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--measure);
    margin: 2rem auto;
    text-align: center;
    color: var(--muted);
  }

  h1 {
    margin-top: 1rem;
    color: var(--text);
  }
</style>

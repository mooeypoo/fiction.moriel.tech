---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PieceSummaries from '../../components/PieceSummaries.astro'
import { getListedPieces, getTags, type Piece } from '../../lib/content'
import { getTagSlug } from '../../lib/pieces'

export async function getStaticPaths() {
  const pieces = await getListedPieces()
  return getTags(pieces).map(({ tag }) => ({
    params: { tag: getTagSlug(tag) },
    props: { tag, pieces: pieces.filter((piece) => piece.data.tags.includes(tag)) },
  }))
}

interface Props {
  tag: string
  pieces: Piece[]
}

const { tag, pieces } = Astro.props
const description = `${pieces.length} ${pieces.length === 1 ? 'piece' : 'pieces'} tagged ${tag}.`
---

<BaseLayout title={tag} description={description} card={`tags/${getTagSlug(tag)}`}>
  <header class="page-header">
    <p class="label"><a href="/tags">Tags</a></p>
    <h1>{tag}</h1>
    <p class="description">{description}</p>
  </header>
  <PieceSummaries pieces={pieces} showType />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .label {
    margin: 0;
  }

  .label a {
    color: inherit;
    text-decoration: none;
  }

  .description {
    color: var(--muted);
  }
</style>

---
// A table of contents, the way a book or journal prints one: title, dotted leader, then the year
// (or date) and optionally the type.
import type { Piece } from '../lib/content'
import { formatDate, getPiecePath, getTypeInfo, getYear } from '../lib/pieces'

interface Props {
  pieces: Piece[]
  date?: 'year' | 'full'
  showType?: boolean
}

const { pieces, date = 'year', showType = false } = Astro.props
---

<ol class="contents">
  {pieces.map((piece) => (
    <li>
      <a href={getPiecePath(piece.id)}>
        <span class="contents-title">{piece.data.title}</span>
        <span class="contents-leader" aria-hidden="true"></span>
        <span class="contents-meta">
          {showType && <span class="label">{getTypeInfo(piece.data.type).label}</span>}
          <time datetime={piece.data.date.toISOString()}>{date === 'year' ? getYear(piece.data.date) : formatDate(piece.data.date)}</time>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .contents {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0;
    color: var(--text);
    text-decoration: none;
  }

  .contents-title {
    font-size: 1.1rem;
  }

  a:hover .contents-title {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .contents-leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 2px dotted var(--rule);
    transform: translateY(-0.3em);
  }

  .contents-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .contents-meta .label {
    font-size: 0.7rem;
  }
</style>

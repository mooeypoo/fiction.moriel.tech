---
import ThemeToggle from './ThemeToggle.vue'
import Wordmark from './Wordmark.astro'
import { TYPES } from '../lib/pieces'
import { CONTACT_URL } from '../lib/site'

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
const links = [...TYPES.map((info) => ({ label: info.nav, href: info.path })), { label: 'Archive', href: '/archive' }, { label: 'Tags', href: '/tags' }]
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`)
---

<header class="site-header">
  <div class="header-inner">
    <a class="home-link" href="/" aria-label="Imaginary Parts, home">
      <Wordmark />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
        {/* Like blog.moriel.tech, header links stay in the same tab, even to other sites. */}
        <li><a href={CONTACT_URL}>Contact</a></li>
      </ul>
    </nav>
    <ThemeToggle client:idle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 1rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
  }

  .home-link {
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  /* On phones the nav takes its own row under the wordmark and toggle. */
  @media (max-width: 720px) {
    nav {
      order: 3;
      width: 100%;
    }

    nav ul {
      gap: 0.25rem 0.85rem;
    }

    nav a {
      font-size: 0.92rem;
    }
  }
</style>
